[Desktop Entry]
# This file overrides /usr/share/applications/org.gnome.SimpleScan.desktop
# (XDG spec: /usr/local/share/ takes precedence over /usr/share/).
#
# It adds LD_PRELOAD=libbr5longpaper.so so the SANE-level hooks are active
# when scanning with a Brother DS-740D or ADS-1200:
#
#   • sane_control_option  — auto-detects long mode when br-y > 300 mm
#   • sane_get_parameters  — returns lines=-1 for streaming reads
#   • sane_get_option_descriptor — exposes br-y up to 5000 mm to the UI
#
# To use long paper mode in Simple Scan:
#   1. Open Settings → Page Size → Custom
#   2. Set Height to the maximum you want (e.g. 1000 mm)
#   3. Feed the document — the scanner stops automatically when paper exits

Name=Document Scanner
GenericName=Scanner
Comment=Scan documents and photos (long paper support via brscan5-longpaper)
Exec=env LD_PRELOAD=/usr/lib/libbr5longpaper.so simple-scan %U
Icon=org.gnome.SimpleScan
Terminal=false
Type=Application
Categories=GNOME;GTK;Office;Scanning;
StartupNotify=false
