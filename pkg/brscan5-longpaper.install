DLL_CONF=/etc/sane.d/dll.conf
BACKEND=brother5lp

_add_backend() {
    if [[ ! -f "$DLL_CONF" ]]; then
        echo "brscan5-longpaper: $DLL_CONF not found — is sane installed?" >&2
        return
    fi
    if grep -qxF "$BACKEND" "$DLL_CONF" 2>/dev/null; then
        echo "brscan5-longpaper: $BACKEND already in $DLL_CONF" >&2
        return
    fi
    echo "$BACKEND" >> "$DLL_CONF"
    echo "brscan5-longpaper: registered '$BACKEND' in $DLL_CONF" >&2
    echo "  Open Simple Scan / XSane and select:" >&2
    echo "    'Brother [model] [Long Paper]'" >&2
}

_remove_backend() {
    sed -i "/^${BACKEND}$/d" "$DLL_CONF" 2>/dev/null || true
    echo "brscan5-longpaper: removed '$BACKEND' from $DLL_CONF" >&2
}

post_install() {
    _add_backend
}

post_upgrade() {
    _add_backend
}

pre_remove() {
    _remove_backend
}
